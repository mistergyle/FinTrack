# Kopieren nach .env und anpassen
APP_PASSWORD=bitte-ein-langes-passwort-waehlen
# Optional, nur für den automatischen FinTS-Abruf (siehe README)
FINTS_PRODUCT_ID=
# Optional: comdirect REST-API (OAuth-Zugangsdaten aus dem comdirect-Konto, siehe README)
COMDIRECT_CLIENT_ID=
COMDIRECT_CLIENT_SECRET=
# 1, wenn die App hinter HTTPS läuft
COOKIE_SECURE=0
